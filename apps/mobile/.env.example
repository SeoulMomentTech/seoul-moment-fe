# Copy to .env for local development.
# Without this file the app falls back to the production API.
EXPO_PUBLIC_API_BASE_URL=https://api-dev.seoulmoment.com.tw
# 공유 링크에 쓰는 웹 주소. 없으면 운영 웹(seoulmoment.com.tw)으로 나간다.
EXPO_PUBLIC_WEB_BASE_URL=https://dev-seoulmoment.netlify.app

# LINE Login 채널 ID. 웹의 NEXT_PUBLIC_LINE_LIFF_ID 앞부분이 바로 이 값이다
# (LIFF ID 는 `{channelId}-{liffApp}` 꼴이다). 채널 시크릿은 쓰지 않는다.
#
# 비어 있으면 로그인 화면의 LINE 버튼이 아예 그려지지 않는다 — 네이티브 SDK 가
# 필요해서 Expo Go 에서는 어차피 끝까지 갈 수 없기 때문이다(dev build 필요).
EXPO_PUBLIC_LINE_CHANNEL_ID=
