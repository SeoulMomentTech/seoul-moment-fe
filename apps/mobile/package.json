    "@tailwindcss/postcss": "catalog:stable",
    "@types/react": "~19.2.2",
    "@typescript/native": "catalog:stable",
    "eslint": "catalog:stable",
    "eslint-config-expo": "~57.0.2",
    "lightningcss": "1.30.1",
    "postcss": "^8.5.26",
    "tailwindcss": "catalog:stable",
    "typescript": "catalog:stable"
