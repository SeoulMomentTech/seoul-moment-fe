{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_API_BASE_URL": "https://api-dev.seoulmoment.com.tw",
        "EXPO_PUBLIC_WEB_BASE_URL": "https://dev-seoulmoment.netlify.app"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.seoulmoment.com.tw",
        "EXPO_PUBLIC_WEB_BASE_URL": "https://seoulmoment.com.tw"
      }
    }
  }
}
