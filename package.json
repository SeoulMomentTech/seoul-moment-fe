{
  "name": "seoul-moment",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:admin": "turbo run build --filter=@seoul-moment/admin",
    "build:ui": "turbo run build --filter=@seoul-moment/ui",
    "build:web": "turbo run build --filter=@seoul-moment/web",
    "dev": "turbo run dev",
    "dev:admin": "turbo run dev --filter=@seoul-moment/admin",
    "dev:web": "turbo run dev --filter=@seoul-moment/web",
    "i18n:sync": "turbo run i18n:sync --filter=@seoul-moment/web",
    "lint": "turbo run lint",
    "lint-staged": "lint-staged",
    "lint:fix:admin": "turbo run lint:fix --filter=@seoul-moment/admin",
    "lint:fix:all": "turbo run lint:fix --filter=@seoul-moment/web --filter=@seoul-moment/admin",
    "lint:fix:web": "turbo run lint:fix --filter=@seoul-moment/web",
    "option:sync": "turbo run option:sync --filter=@seoul-moment/web",
    "prepare": "husky",
    "start": "turbo run start --filter=@seoul-moment/web",
    "test:admin-e2e": "turbo run test:e2e --filter=@seoul-moment/admin",
    "test:admin-e2e:ui": "turbo run test:e2e:ui --filter=@seoul-moment/admin",
    "test:e2e": "turbo run test:e2e",
    "test:web-e2e": "turbo run test:e2e --filter=@seoul-moment/web",
    "test:web-e2e:ui": "turbo run test:e2e:ui --filter=@seoul-moment/web",
    "typecheck": "turbo run typecheck",
    "typecheck:admin": "turbo run typecheck --filter=@seoul-moment/admin",
    "typecheck:web": "turbo run typecheck --filter=@seoul-moment/web"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.0",
    "@seoul-moment/prettier-config": "workspace:*",
    "eslint-plugin-react-hooks": "catalog:stable",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.6.2",
    "prettier-plugin-packagejson": "^2.5.19",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.1.2"
  },
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "tsconfck>typescript": "6"
      }
    },
    "overrides": {
      "postcss": "^8.5.26"
    }
  }
}
