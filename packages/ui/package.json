{
  "name": "@seoul-moment/ui",
  "version": "0.1.0",
  "private": false,
  "sideEffects": [
    "./dist/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -b --force && pnpm run build:css",
    "build:css": "npx @tailwindcss/cli -i ./src/styles.css -o ./dist/styles.css",
    "dev": "npx @tailwindcss/cli -i ./src/styles.css -o ./dist/styles.css --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b",
    "typecheck:ts6": "tsc6 -b"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "catalog:stable",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "catalog:stable",
    "@radix-ui/react-dropdown-menu": "catalog:stable",
    "@radix-ui/react-label": "catalog:stable",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "catalog:stable",
    "@radix-ui/react-slot": "catalog:stable",
    "@radix-ui/react-tabs": "catalog:stable",
    "class-variance-authority": "^0.7.0",
    "clsx": "catalog:stable",
    "radix-ui": "^1.4.3",
    "react-hook-form": "catalog:stable",
    "tailwind-merge": "catalog:stable",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "catalog:stable",
    "@seoul-moment/eslint-config": "workspace:*",
    "@tailwindcss/cli": "catalog:stable",
    "@types/node": "catalog:stable",
    "@types/react": "catalog:stable",
    "@types/react-dom": "catalog:stable",
    "@typescript/native": "catalog:stable",
    "@vitejs/plugin-react": "catalog:stable",
    "eslint": "catalog:stable",
    "eslint-plugin-react-hooks": "catalog:stable",
    "eslint-plugin-react-refresh": "catalog:stable",
    "globals": "catalog:stable",
    "tailwindcss": "catalog:stable",
    "typescript": "catalog:stable",
    "typescript-eslint": "catalog:stable",
    "vite": "catalog:stable"
  },
  "peerDependencies": {
    "lucide-react": "^0.511.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
